{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/lsfdev-session-track.ps1"],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/lsfdev-session-stop.ps1"],
            "timeout": 180,
            "statusMessage": "Stopping lsFusion dev servers started in this session..."
          }
        ]
      }
    ]
  }
}
